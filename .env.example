# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# URL pública da plataforma
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Criptografa as chaves de pagamento dos profissionais.
# Use um valor aleatório longo e NUNCA altere esta chave depois de já
# existirem chaves de pagamento criptografadas no banco, pois isso as
# tornaria impossíveis de descriptografar.
CHAVE_CRIPTOGRAFIA_PAGAMENTOS=

# Push notifications (VAPID). Gere um par novo para produção.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@booqly.com.br

# CRON da Vercel — obrigatório para as rotinas automáticas.
CRON_SECRET=

# WhatsApp / Meta — usado para login por WhatsApp e webhook.
WHATSAPP_NUMERO_VERIFICACAO=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_CODIGO_TEMPLATE=
WHATSAPP_CODIGO_TEMPLATE_LANGUAGE=pt_BR
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
